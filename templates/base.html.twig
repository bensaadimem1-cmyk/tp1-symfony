<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Mon application Symfony{% endblock %}</title>

        {% block stylesheets %}
            <style>
                body {
                    font-family: Arial, sans-serif;
                    margin: 0;
                    background: #f5f5f5;
                    color: #222;
                }

                nav {
                    background: #222;
                    padding: 16px 30px;
                }

                nav a {
                    color: white;
                    text-decoration: none;
                    margin-right: 20px;
                }

                main {
                    padding: 30px;
                }
            </style>
        {% endblock %}
    </head>

    <body>
        <nav>
            <a href="{{ path('app_accueil') }}">Accueil</a>
            <a href="{{ path('app_bonjour', {'prenom': 'Marie'}) }}">Bonjour</a>
            <a href="{{ path('app_profil') }}">Profil</a>
	    <a href="{{ path('app_articles') }}">Articles</a>
        <a class="nav-link" href="{{ path('app_taches') }}">Tâches</a>
        </nav>

        <main>
            {% block body %}{% endblock %}
        </main>

        {% block javascripts %}
        {% endblock %}
    </body>
</html>
