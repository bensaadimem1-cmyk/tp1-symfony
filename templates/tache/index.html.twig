{% extends 'base.html.twig' %}

{% block title %}Mes tâches{% endblock %}

{% block body %}
    <h1 class="mb-4">📝 Mes tâches</h1>

    <a href="{{ path('app_tache_ajouter') }}" class="btn btn-primary mb-3">+ Ajouter une tâche</a>

    {% if taches is empty %}
        <div class="alert alert-info">Aucune tâche pour le moment.</div>
    {% else %}
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Titre</th>
                    <th>Date</th>
                    <th>Statut</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% for tache in taches %}
                    <tr>
                        <td style="{{ tache.terminee ? 'text-decoration: line-through; color: grey;' : '' }}">
                            <a href="{{ path('app_tache_detail', {id: tache.id}) }}">{{ tache.titre }}</a>
                        </td>
                        <td>{{ tache.dateCreation|date('d/m/Y H:i') }}</td>
                        <td>
                            {% if tache.terminee %}
                                <span class="badge bg-success">✅ Terminée</span>
                            {% else %}
                                <span class="badge bg-warning text-dark">⏳ En cours</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if not tache.terminee %}
                                <a href="{{ path('app_tache_terminer', {id: tache.id}) }}" class="btn btn-sm btn-success">Terminer</a>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <p class="text-muted">{{ taches|length }} tâche(s)</p>
    {% endif %}
{% endblock %}